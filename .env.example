# --- LLM 配置（复制为 .env 后填写，.env 不会被提交）---
# 任意 OpenAI 兼容的 API 服务均可：DeepSeek / OpenAI / 通义 / 智谱 / 本地 vLLM 等
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 设为 1 时不调用真实 API，用内置示例代码走通全流程（开发/演示用）
LLM_MOCK=0

# 默认只发送数据结构和数值统计，不发送分类列样本值；设为 1 才允许发送脱敏后的 top values
LLM_SEND_DATA_VALUES=0

# 生成/对话/参数调整失败时，自动调用 LLM 修复的最多次数
AUTO_REPAIR_ATTEMPTS=1

# docker：使用 backend/Dockerfile.sandbox 构建的默认隔离容器
SANDBOX_MODE=docker
DOCKER_IMAGE=quick-sciplot-sandbox:0.2.0
# 仅可信本机开发/评测可设为 1；process 不是操作系统级安全边界
ALLOW_UNSAFE_PROCESS_SANDBOX=0

# --- 服务配置 ---
HOST=127.0.0.1
PORT=8000
# 临时数据与输出目录（相对 backend/ 或绝对路径）
DATA_DIR=./data
# 允许的 Host 请求头（JSON 数组）。服务只监听回环地址，但会向任何回环请求下发会话 cookie，
# 因此拒绝 Host 为其它域名的请求以防御 DNS 重绑定；通过自定义主机名访问时才需要修改。
# ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]

# --- 输入解析、并发与历史产物限制 ---
MAX_IMPORT_BYTES=209715200
MAX_TOTAL_IMPORT_BYTES=524288000
MAX_JSON_BYTES=67108864
MAX_JSON_NESTING=64
MAX_ARCHIVE_MEMBERS=4096
MAX_ARCHIVE_EXPANDED_BYTES=536870912
MAX_EXCEL_SHEETS=50
MAX_PARSE_CONCURRENCY=2
MAX_PLOT_CONCURRENCY=2
MAX_OUTPUT_BYTES=1073741824
MAX_REVISIONS_PER_DATASET=50
SANDBOX_TIMEOUT=60
